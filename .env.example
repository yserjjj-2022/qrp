# Путь к базе данных SQLite (устаревшее имя: настройками не читается)
DB_PATH=

# Явный путь к базе: приоритетнее paths.db в config.yaml.
# Нужен для работы на копии: QA_DB_PATH=/tmp/qrp_copy.db uv run qa-pipeline review-terms
QA_DB_PATH=

# Каталог данных
DATA_DIR=

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Провайдер LLM (по умолчанию "stub")
LLM_PROVIDER=

# Модель LLM (идентификатор сверяется со списком провайдера)
LLM_MODEL=

# Эндпоинт LLM (прокси)
LLM_ENDPOINT=

# Максимум вызовов LLM за один прогон
LLM_MAX_CALLS_PER_RUN=

# Каталог кэша LLM
LLM_CACHE_DIR=

# Бэкенд векторного поиска
VECTORS_BACKEND=

# Модель эмбеддингов
EMBEDDING_MODEL=

# Модель для нормализации L2 (отдельная от основной)
LLM_MODEL_NORMALIZE=

# Путь к таблице «имя -> код» (вне репозитория)
NAMES_MAP_PATH=

# Секрет: API-ключ LLM (обязателен, если LLM_PROVIDER != "stub")
LLM_API_KEY=
