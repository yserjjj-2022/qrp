# Путь к базе данных SQLite
DB_PATH=

# Каталог данных
DATA_DIR=

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Провайдер LLM (по умолчанию "stub")
LLM_PROVIDER=

# Модель LLM (идентификатор сверяется со списком провайдера)
LLM_MODEL=

# Эндпоинт LLM (прокси)
LLM_ENDPOINT=

# Максимум вызовов LLM за один прогон
LLM_MAX_CALLS_PER_RUN=

# Каталог кэша LLM
LLM_CACHE_DIR=

# Бэкенд векторного поиска
VECTORS_BACKEND=

# Модель эмбеддингов
EMBEDDING_MODEL=

# Секрет: API-ключ LLM (обязателен, если LLM_PROVIDER != "stub")
LLM_API_KEY=
